#!/usr/bin/env python3
# ptt-keywatch - block until a key is released, then exit. Runs in the
# background off ptt begin, with no terminal, so it prints nothing.
import glob
import os
import select
import struct
import sys

# struct input_event: two longs of timeval, then type, code, value.
EVENT_FORMAT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)
EV_KEY = 0x01
RELEASE = 0


def open_devices():
    fds = []
    for path in sorted(glob.glob("/dev/input/event*")):
        try:
            fds.append(os.open(path, os.O_RDONLY))
        except OSError:
            pass
    return fds


def watch(keycode, fds):
    while fds:
        ready, _, _ = select.select(fds, [], [])
        for fd in ready:
            try:
                data = os.read(fd, EVENT_SIZE)
            except OSError:
                os.close(fd)
                fds.remove(fd)
                continue
            if len(data) < EVENT_SIZE:
                continue
            _, _, etype, code, value = struct.unpack(EVENT_FORMAT, data)
            if etype == EV_KEY and code == keycode and value == RELEASE:
                return 0
    return 1


def main(argv):
    if len(argv) != 2:
        return 2
    try:
        keycode = int(argv[1])
    except ValueError:
        return 2

    fds = open_devices()
    # An empty list makes select block forever, which would leave dictation
    # running with nothing to stop it.
    if not fds:
        return 1
    try:
        return watch(keycode, fds)
    finally:
        for fd in fds:
            try:
                os.close(fd)
            except OSError:
                pass


if __name__ == "__main__":
    sys.exit(main(sys.argv))
