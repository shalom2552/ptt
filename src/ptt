#!/usr/bin/env bash
# ptt - push to talk voice typing. begin and end run off a key press,
# install and uninstall hand off to ptt-install.
set -Eeuo pipefail

PTT_ROOT="$(dirname "$(dirname "$(readlink -f "$0")")")"
source "$PTT_ROOT/src/lib/log.sh"
source "$PTT_ROOT/src/lib/ui.sh"

# Swapping the speech engine should mean rewriting this block and nothing else.
BIN=nerd-dictation
ARGS=(
    --simulate-input-tool=WTYPE
    --idle-time=0.2
    --punctuate-from-previous-timeout=2
    --full-sentence
    # Hang backstop: exits on its own after 30s with no speech processed.
    --timeout 30
    --config "$PTT_ROOT/src/ptt-config.py"
)
# Typing during the hold can eat the key release. The watcher reads the
# release off the device, so live mode does not need this.
DEFER_ARGS=(--defer-output)
PKGS=(wtype nerd-dictation-git)
KEY=F12 # must match the keybind
KEYCODE=88

RUN="${XDG_RUNTIME_DIR:-/tmp}"
LOCK="$RUN/ptt.lock"
SESSION="$RUN/ptt.session" # cookie path and start stamp of the last begin
STOP="$RUN/ptt.stop"       # stamp of the last release

# One tray slot, so a notice replaces the last instead of stacking.
notify() {
    local urgency=$1 timeout=$2 title=$3 body=$4
    notify-send -u "$urgency" -h string:x-canonical-private-synchronous:ptt \
        -t "$timeout" "$title" "$body" || true
}

notify_warn() { notify "critical" 10000 "$1" "$2"; }

# Off a key press there is no terminal, so failures also go to the screen.
trap 'log_error "failed on line $LINENO: $BASH_COMMAND"
      notify_warn "ptt failed" "line $LINENO: $BASH_COMMAND"' ERR

require_engine() {
    if ! command -v "$BIN" &>/dev/null; then
        notify_warn "Voice typing not installed" "Run: ${PTT_ROOT/#$HOME/\~}/ptt install"
        exit 0
    fi
}

# The engine holds its cookie at mtime 0 while listening, stamps it on end.
session_live() { [[ $(stat -c %Y "$1" 2>/dev/null) == 0 ]]; }

stamp() { date +%s%N; } # ns, so two presses in one second still order

# Stamp of the last release, 0 when there has been none.
last_stop() {
    local s=0
    [[ -e $STOP ]] && read -r s <"$STOP"
    printf '%s\n' "$s"
}

notify_state() { notify "normal" "$1" ptt "$2"; }

# Tests the device, not the input group: a session predating its own gpasswd
# is in the group and still cannot open one.
can_watch() {
    local dev
    for dev in /dev/input/event*; do
        [[ -r $dev ]] && return 0
    done
    return 1
}

# Ends one named session, never whichever one happens to be up.
end_session() {
    local cookie=$1
    # Watcher and release bind both arrive. The loser of the race must not
    # end again, or the engine throws on the gone cookie.
    exec 9>"$LOCK"
    flock -n 9 || return 0
    session_live "$cookie" || return 0
    # A late end of a superseded session must not talk over the live one.
    local cur=''
    [[ -e $SESSION ]] && read -r cur _ <"$SESSION"
    [[ $cur == "$cookie" ]] && notify_state 1000 done
    "$BIN" end --cookie "$cookie"
}

# Backgrounded by begin in live mode. Ends the session when the key comes up.
watch_release() {
    if "$PTT_ROOT/src/ptt-keywatch" "$KEYCODE"; then
        end_session "$1"
    else
        notify_warn ptt "key watcher failed, dictation stops on timeout"
    fi
}

# A release that beats the engine to its cookie leaves end nothing to stop.
catch_early_release() {
    local cookie=$1 start=$2 deadline=$((SECONDS + 3))
    while ((SECONDS < deadline)); do
        session_live "$cookie" && break
        sleep 0.1
    done
    (($(last_stop) > start)) || return 0
    end_session "$cookie"
}

cmd_begin() {
    require_engine
    local cookie prev pstart start
    # Only a session still held blocks a new one. One already released is
    # ending, however long its engine takes to type the text out.
    if [[ -e $SESSION ]]; then
        read -r prev pstart <"$SESSION"
        if session_live "$prev" && (($(last_stop) < pstart)); then
            exit 0
        fi
    fi
    cookie="$RUN/ptt.cookie.$$"
    start=$(stamp)
    local -a args=("${ARGS[@]}" --cookie "$cookie")
    if can_watch; then
        watch_release "$cookie" &
    else
        args+=("${DEFER_ARGS[@]}")
    fi
    printf '%s %s\n' "$cookie" "$start" >"$SESSION"
    notify_state 30000 listening
    setsid -f "$BIN" begin "${args[@]}" # detached, caller returns at once
    catch_early_release "$cookie" "$start"
}

cmd_end() {
    command -v "$BIN" &>/dev/null || exit 0
    stamp >"$STOP"
    [[ -e $SESSION ]] || exit 0
    local cookie
    read -r cookie _ <"$SESSION"
    end_session "$cookie"
}

CMD=''
MODEL=0
MODEL_ARG=''
for a in "$@"; do
    case "$a" in
        -h | --help)
            usage ptt
            exit 0
            ;;
        -s | --step) export PTT_STEP=1 ;;
        -m | --model)
            MODEL=1
            MODEL_ARG="$a"
            ;;
        begin | end | install | uninstall)
            if [[ -n $CMD ]]; then bad_arg ptt "$a"; fi
            CMD="$a"
            ;;
        *) bad_arg ptt "$a" ;;
    esac
done

# A flag may come before its command, so this waits for the whole line.
if ((MODEL)) && [[ $CMD != install ]]; then bad_arg ptt "$MODEL_ARG"; fi

case "$CMD" in
    begin) cmd_begin ;;
    end) cmd_end ;;
    install)
        FLAGS=()
        if ((MODEL)); then FLAGS=(--model); fi
        exec "$PTT_ROOT/src/ptt-install" install "${FLAGS[@]}"
        ;;
    uninstall) exec "$PTT_ROOT/src/ptt-install" uninstall ;;
    *) usage ptt ;;
esac
