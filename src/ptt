#!/usr/bin/env bash
# ptt - push to talk voice typing. begin and end run off a key press,
# install and uninstall hand off to ptt-install.
set -Eeuo pipefail

PTT_ROOT="$(dirname "$(dirname "$(readlink -f "$0")")")"
source "$PTT_ROOT/src/lib/log.sh"
source "$PTT_ROOT/src/lib/ui.sh"

# Swapping the speech engine should mean rewriting this block and nothing else.
BIN=nerd-dictation
ARGS=(
    --simulate-input-tool=WTYPE
    --idle-time=0.2
    --punctuate-from-previous-timeout=2
    --full-sentence
    # Hang backstop: exits on its own after 30s with no speech processed.
    --timeout 30
    --config "$PTT_ROOT/src/ptt-config.py"
)
# Deferred mode only. Without it wtype types during the hold, Hyprland loses
# the key release, and dictation never stops. The watcher reads the release
# off the device, so live mode does not need it.
DEFER_ARGS=(--defer-output)
PKGS=(wtype nerd-dictation-git)
# Must match the Hyprland bind.
KEY=F12
KEYCODE=88

# A live session shows as "python3 /usr/bin/nerd-dictation begin ...".
# Ending shows as "... end", which this must not match.
PATTERN="$BIN begin"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/ptt.lock"

# One tray slot, so a notice replaces the last instead of stacking.
notify() {
    local urgency=$1 timeout=$2 title=$3 body=$4
    notify-send -u "$urgency" -h string:x-canonical-private-synchronous:ptt \
        -t "$timeout" "$title" "$body" || true
}

notify_warn() { notify "critical" 10000 "$1" "$2"; }

# Off a key press there is no terminal, so failures also go to the screen.
trap 'log_error "failed on line $LINENO: $BASH_COMMAND"
      notify_warn "ptt failed" "line $LINENO: $BASH_COMMAND"' ERR

require_engine() {
    if ! command -v "$BIN" &>/dev/null; then
        notify_warn "Voice typing not installed" "Run: ${PTT_ROOT/#$HOME/\~}/ptt install"
        exit 0
    fi
}

engine_running() { pgrep -f "$PATTERN" &>/dev/null; }

notify_state() { notify "normal" "$1" ptt "$2"; }

# True when the watcher has something to read. A session that predates its own
# gpasswd is in the input group and still cannot open a device, so this tests
# the device and not the group.
can_watch() {
    local dev
    for dev in /dev/input/event*; do
        [[ -r $dev ]] && return 0
    done
    return 1
}

# Backgrounded by begin in live mode. Ends the session when the key comes up.
watch_release() {
    if "$PTT_ROOT/src/ptt-keywatch" "$KEYCODE"; then
        cmd_end
    else
        notify_warn ptt "key watcher failed, dictation stops on timeout"
    fi
}

cmd_begin() {
    require_engine
    engine_running && exit 0
    local -a args=("${ARGS[@]}")
    if can_watch; then
        watch_release &
    else
        args+=("${DEFER_ARGS[@]}")
    fi
    notify_state 30000 listening
    setsid -f "$BIN" begin "${args[@]}" # detached, caller returns at once
}

cmd_end() {
    command -v "$BIN" &>/dev/null || exit 0
    # Live mode reaches here twice, from the watcher and from the release
    # bind. Two engine ends race, and the loser throws on the gone cookie.
    exec 9>"$LOCK"
    flock -n 9 || exit 0
    # The watcher is backgrounded before begin spawns the engine, so a quick
    # tap lands here while there is still nothing to end.
    if can_watch; then
        local deadline=$((SECONDS + 2))
        while ((SECONDS < deadline)); do
            engine_running && break
            sleep 0.1
        done
    fi
    notify_state 1000 done
    # Without this guard a release with nothing running throws a Python
    # traceback off a stale cookie.
    engine_running || exit 0
    "$BIN" end
}

CMD=''
MODEL=0
for a in "$@"; do
    case "$a" in
        -h | --help)
            usage ptt
            exit 0
            ;;
        -s | --step) export PTT_STEP=1 ;;
        --model) MODEL=1 ;;
        begin | end | install | uninstall)
            if [[ -n $CMD ]]; then bad_arg ptt "$a"; fi
            CMD="$a"
            ;;
        *) bad_arg ptt "$a" ;;
    esac
done

# A flag may come before its command, so this waits for the whole line.
if ((MODEL)) && [[ $CMD != install ]]; then bad_arg ptt --model; fi

case "$CMD" in
    begin) cmd_begin ;;
    end) cmd_end ;;
    install)
        FLAGS=()
        if ((MODEL)); then FLAGS=(--model); fi
        exec "$PTT_ROOT/src/ptt-install" install "${FLAGS[@]}"
        ;;
    uninstall) exec "$PTT_ROOT/src/ptt-install" uninstall ;;
    *) usage ptt ;;
esac
