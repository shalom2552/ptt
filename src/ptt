#!/usr/bin/env bash
# ptt - push to talk voice typing. begin and end run off a key press,
# install and uninstall hand off to ptt-install.
set -Eeuo pipefail

PTT_ROOT="$(dirname "$(dirname "$(readlink -f "$0")")")"
source "$PTT_ROOT/src/lib/log.sh"
source "$PTT_ROOT/src/lib/ui.sh"

# Swapping the speech engine should mean rewriting this block and nothing else.
BIN=nerd-dictation
ARGS=(
    --simulate-input-tool=WTYPE
    --idle-time=0.2
    --punctuate-from-previous-timeout=2
    --full-sentence
    # Hang backstop: exits on its own after 30s with no speech processed.
    --timeout 30
    --config "$PTT_ROOT/src/ptt-config.py"
)

# One tray slot, so a notice replaces the last instead of stacking.
notify() {
    local urgency=$1 timeout=$2 title=$3 body=$4
    notify-send -u "$urgency" -h string:x-canonical-private-synchronous:ptt \
        -t "$timeout" "$title" "$body" || true
}

notify_warn() { notify "critical" 10000 "$1" "$2"; }

say_state() {
    local timeout=$1 text=$2
    printf '%s\n' "$text"
    notify "normal" "$timeout" ptt "$text"
}

# Off a key press there is no terminal, so failures also go to the screen.
trap 'log_error "failed on line $LINENO: $BASH_COMMAND"
      notify_warn "ptt failed" "line $LINENO: $BASH_COMMAND"' ERR

# Every runtime file is per session. No session directory, no run.
if [[ -z ${XDG_RUNTIME_DIR:-} ]]; then
    log_error "XDG_RUNTIME_DIR is not set"
    notify_warn "ptt cannot run" "XDG_RUNTIME_DIR is not set."
    exit 1
fi

RUN="$XDG_RUNTIME_DIR"
SESSION="$RUN/ptt.session" # cookie path of the last begin
LOG="$RUN/ptt.log" # output of the detached engine

require_engine() {
    if ! command -v "$BIN" &>/dev/null; then
        local hint="${PTT_ROOT/#$HOME/\~}/ptt install"
        log_error "voice typing not installed, run $hint"
        notify_warn "Voice typing not installed" "Run: $hint"
        exit 1
    fi
}

# The engine holds its cookie at mtime 0 while listening, stamps it on end.
# A crash leaves mtime 0 behind, so the pid in the cookie decides.
session_live() {
    local pid=''
    [[ $(stat -c %Y "$1" 2>/dev/null) == 0 ]] || return 1
    read -r pid <"$1" || true
    case $pid in '' | *[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null
}

# Ends one named session, never whichever one happens to be up.
end_session() {
    local cookie=$1
    # Release bind and a late begin both arrive. The loser must not end again.
    exec 9>"$cookie.lock"
    flock -n 9 || return 0
    session_live "$cookie" || return 0
    # A late end of a superseded session must not talk over the live one.
    [[ -e $SESSION && $(<"$SESSION") == "$cookie" ]] && say_state 1000 done
    "$BIN" end --cookie "$cookie"
    rm -f "$cookie.stop" "$cookie.lock"
}

cmd_begin() {
    require_engine
    local prev='' cookie deadline
    [[ -e $SESSION ]] && read -r prev <"$SESSION"
    cookie="$RUN/ptt.cookie.$$"
    if [[ -n $prev ]] && session_live "$prev"; then
        # Only a session still held blocks a new one. A released one is ending.
        if [[ ! -e $prev.stop ]]; then
            log_warn "session already live"
            exit 0
        fi
        # Two engines typing into one window is worse than a late start.
        deadline=$((SECONDS + 3))
        while ((SECONDS < deadline)) && session_live "$prev"; do sleep 0.1; done
        if session_live "$prev"; then
            log_warn "the previous session has not ended"
            notify_warn "Voice typing busy" "The last session is stuck."
            exit 1
        fi
    elif [[ -e $prev ]]; then
        # The engine reads its run-on punctuation off the cookie age.
        touch -r "$prev" "$cookie"
    fi
    rm -f "$cookie.stop" # a recycled pid must not inherit a release
    printf '%s\n' "$cookie" >"$SESSION"
    say_state 30000 listening
    : >"$LOG" # one session deep, so a failure is the one just seen
    # Detached, so the engine outlives this process.
    setsid -f "$BIN" begin "${ARGS[@]}" --cookie "$cookie" >>"$LOG" 2>&1
    # A release that beats the engine to its cookie leaves end nothing to stop.
    deadline=$((SECONDS + 3))
    while ((SECONDS < deadline)) && ! session_live "$cookie"; do sleep 0.1; done
    # A cookie that never goes live means the engine is already gone.
    if ! session_live "$cookie"; then
        log_error "engine did not start, see $LOG"
        notify_warn "Voice typing failed" "The engine did not start. See $LOG"
        exit 1
    fi
    [[ -e $cookie.stop ]] || return 0
    end_session "$cookie"
}

cmd_end() {
    require_engine
    local cookie=''
    if [[ -e $SESSION ]]; then read -r cookie <"$SESSION" || true; fi
    # A stamped cookie already ended. A missing one is still starting.
    if [[ -z $cookie ]] ||
        { [[ -e $cookie ]] && ! session_live "$cookie"; }; then
        log_warn "no session running"
        return 0
    fi
    : >"$cookie.stop"
    end_session "$cookie"
}

CMD=''
MODEL=0
MODEL_ARG=''
STEP=0
STEP_ARG=''
for a in "$@"; do
    case "$a" in
        -h | --help)
            usage ptt
            exit 0
            ;;
        -s | --step)
            STEP=1
            STEP_ARG="$a"
            ;;
        -m | --model)
            MODEL=1
            MODEL_ARG="$a"
            ;;
        begin | end | install | uninstall)
            if [[ -n $CMD ]]; then bad_arg ptt "$a"; fi
            CMD="$a"
            ;;
        *) bad_arg ptt "$a" ;;
    esac
done

# A flag may come before its command, so this waits for the whole line.
if ((MODEL)); then
    if [[ -z $CMD ]]; then
        CMD=install
    elif [[ $CMD != install ]]; then
        bad_arg ptt "$MODEL_ARG"
    fi
fi
if ((STEP)); then
    case "$CMD" in
        install | uninstall) export PTT_STEP=1 ;;
        *) bad_arg ptt "$STEP_ARG" ;;
    esac
fi

case "$CMD" in
    begin) cmd_begin ;;
    end) cmd_end ;;
    install)
        FLAGS=()
        if ((MODEL)); then FLAGS=(--model); fi
        exec "$PTT_ROOT/src/ptt-install" install ${FLAGS[@]+"${FLAGS[@]}"}
        ;;
    uninstall) exec "$PTT_ROOT/src/ptt-install" uninstall ;;
    *) usage ptt ;;
esac
