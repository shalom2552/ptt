#!/usr/bin/env bash
# ptt-install - install, re-configure, or remove the ptt voice typing stack.
set -Eeuo pipefail

PTT_ROOT="$(dirname "$(dirname "$(readlink -f "$0")")")"
source "$PTT_ROOT/src/lib/log.sh"
source "$PTT_ROOT/src/lib/ui.sh"

BIN_LINK="$HOME/.local/bin/ptt"
ND_CONFIG="$HOME/.config/nerd-dictation"
MODEL_LINK="$ND_CONFIG/model"
MODEL_ROOT="/usr/share/vosk-models"
HYPR_DIR="$HOME/.config/hypr"
USER_NAME="${USER:-$(id -un)}"

ZSH_COMP_DIR=/usr/share/zsh/site-functions
BASH_COMP_DIR=/usr/share/bash-completion/completions
ZSH_COMP_LINK="$ZSH_COMP_DIR/_ptt"
BASH_COMP_LINK="$BASH_COMP_DIR/ptt"
ZSH_COMP_SRC="$PTT_ROOT/share/completions/ptt.zsh"
BASH_COMP_SRC="$PTT_ROOT/share/completions/ptt.bash"

REPO_PKGS=(wtype)
AUR_PKGS=(nerd-dictation-git)

# Model menu, smallest first. DEFAULT_MODEL is the index preselected on enter.
MODEL_PKGS=(vosk-model-small-en-us vosk-model-en-us-lgraph vosk-model-en-us)
MODEL_DIRS=(small-en-us en-us-lgraph en-us)
MODEL_VERS=(0.15 0.22 0.22)
MODEL_SIZES=("~40 MB" "~128 MB" "~1.8 GB")
DEFAULT_MODEL=0

# -E propagates this into functions, so nothing fails silently.
trap 'log_error "failed on line $LINENO: $BASH_COMMAND"; log_error "exiting, the machine is left as it is"' ERR

pkg_installed() { pacman -Qq "$1" &>/dev/null; }

# The group database, not this session's credentials.
group_in_db() {
    getent group input 2>/dev/null | cut -d: -f4 | tr ',' '\n' | grep -qx "$USER_NAME"
}

# What this session actually has. Only set at login, so it can lag the database.
group_in_session() { id -nG | tr ' ' '\n' | grep -qx input; }

mode_desc() {
    if group_in_session; then
        echo "live (in input group)"
    elif group_in_db; then
        echo "deferred until logout (in input group, session predates it)"
    else
        echo "deferred (not in input group)"
    fi
}

mode_effect() {
    if group_in_session; then
        echo "text appears while speaking"
    else
        echo "the utterance appears on key release"
    fi
}

is_installed() {
    command -v nerd-dictation &>/dev/null && [[ -L $MODEL_LINK ]]
}

model_index_for_dir() {
    local dir="$1" i
    for i in "${!MODEL_DIRS[@]}"; do
        if [[ ${MODEL_DIRS[i]} == "$dir" ]]; then
            printf '%s' "$i"
            return 0
        fi
    done
    return 1
}

# A link this copy of the repo owns, as opposed to one left by another clone.
link_current() {
    [[ -L $1 && "$(readlink -f "$1")" == "$(readlink -f "$2")" ]]
}

# Completions are a convenience, so a declined step leaves the install good.
link_completions() {
    local linked=0
    if [[ -d $ZSH_COMP_DIR ]] && run_cmd "link the zsh completion" \
        sudo ln -sfn "$ZSH_COMP_SRC" "$ZSH_COMP_LINK"; then
        linked=1
    fi
    if [[ -d $BASH_COMP_DIR ]] && run_cmd "link the bash completion" \
        sudo ln -sfn "$BASH_COMP_SRC" "$BASH_COMP_LINK"; then
        linked=1
    fi
    if ((linked)); then
        log_info "Tab completion works in a new shell."
    fi
}

# An earlier install links into wherever the clone was then. Moving it leaves
# those links pointing at the old path.
offer_relink() {
    local -a stale=()
    if [[ -L $BIN_LINK ]] && ! link_current "$BIN_LINK" "$PTT_ROOT/ptt"; then
        stale+=(bin)
    fi
    if [[ -L $ZSH_COMP_LINK ]] && ! link_current "$ZSH_COMP_LINK" "$ZSH_COMP_SRC"; then
        stale+=(zsh)
    fi
    if [[ -L $BASH_COMP_LINK ]] && ! link_current "$BASH_COMP_LINK" "$BASH_COMP_SRC"; then
        stale+=(bash)
    fi
    ((${#stale[@]})) || return 0

    local item n=0
    heading "ptt has moved"
    plan_title "ptt install will:"
    for item in "${stale[@]}"; do
        case "$item" in
            bin) plan_line "$((++n))" "repoint $(arg "${BIN_LINK/#$HOME/\~}") at this copy" ;;
            zsh) plan_line "$((++n))" "repoint $(arg "$ZSH_COMP_LINK")" ;;
            bash) plan_line "$((++n))" "repoint $(arg "$BASH_COMP_LINK")" ;;
        esac
    done
    printf '\n'
    plan_step_note
    if ! confirm "Proceed?"; then
        log_warn "The links still point at the old path."
        return 0
    fi

    for item in "${stale[@]}"; do
        case "$item" in
            bin) run_cmd "repoint ptt on PATH" \
                ln -sfn "$PTT_ROOT/ptt" "$BIN_LINK" || true ;;
            zsh) run_cmd "repoint the zsh completion" \
                sudo ln -sfn "$ZSH_COMP_SRC" "$ZSH_COMP_LINK" || true ;;
            bash) run_cmd "repoint the bash completion" \
                sudo ln -sfn "$BASH_COMP_SRC" "$BASH_COMP_LINK" || true ;;
        esac
    done
}

current_model_dir() {
    local target
    target="$(readlink "$MODEL_LINK" 2>/dev/null)" || return 1
    basename "$target"
}

print_plan() {
    local n=0
    plan_title "ptt install will:"
    plan_line "$((++n))" "install $(arg "${REPO_PKGS[*]}") from the official repos"
    plan_line "$((++n))" "install $(arg "${AUR_PKGS[*]}") from the AUR"
    plan_line "$((++n))" "install a vosk model, picked from a menu"
    plan_line "$((++n))" "point $(arg "${MODEL_LINK/#$HOME/\~}") at that model"
    plan_line "$((++n))" "link ptt onto PATH at $(arg "${BIN_LINK/#$HOME/\~}")"
    if [[ -d $ZSH_COMP_DIR ]]; then
        plan_line "$((++n))" "link the zsh completion into $(arg "$ZSH_COMP_DIR")"
    fi
    if [[ -d $BASH_COMP_DIR ]]; then
        plan_line "$((++n))" "link the bash completion into $(arg "$BASH_COMP_DIR")"
    fi
    if ! group_in_db; then
        plan_line "$((++n))" "offer to join the $(arg input) group for live text"
    fi
    printf '\n'
    plan_step_note
    plan_note "pacman and yay prompt for sudo themselves."
}

choose_model() {
    local i
    heading "Choose a model" >&2
    printf '\n' >&2
    for i in "${!MODEL_PKGS[@]}"; do
        printf '  %d) %-24s %-5s %s%s\n' \
            "$((i + 1))" "${MODEL_PKGS[i]}" "${MODEL_VERS[i]}" "${MODEL_SIZES[i]}" \
            "$([[ $i -eq $DEFAULT_MODEL ]] && echo '  (default)')" >&2
        printf '     %s%s%s\n\n' "$C_DIM" "$MODEL_ROOT/${MODEL_DIRS[i]}" "$C_RESET" >&2
    done
    printf '\n' >&2
    prompt_index "${#MODEL_PKGS[@]}" "Model" "$DEFAULT_MODEL" >&2
}

install_model() {
    local i="$1"
    run_or_stop "install the ${MODEL_DIRS[i]} model, ${MODEL_SIZES[i]}" \
        yay -S --needed "${MODEL_PKGS[i]}"
    mkdir -p "$ND_CONFIG"
    run_or_stop "point nerd-dictation at that model" \
        ln -sfn "$MODEL_ROOT/${MODEL_DIRS[i]}" "$MODEL_LINK"
    log_info "model: ${MODEL_DIRS[i]} (${MODEL_VERS[i]}) linked at ${MODEL_LINK/#$HOME/\~}"
}

offer_group() {
    heading "Live text needs the input group"
    printf '\nJoin for live text that appears while speaking.\n'
    printf 'Decline for deferred text on key release.\n'
    ask_cmd "join the input group, applies after logout" \
        sudo gpasswd -a "$USER_NAME" input
}

print_bind_help() {
    if [[ ! -d $HYPR_DIR ]]; then
        log_info "ptt is installed and runs from a terminal."
        log_info "Key binding is compositor specific."
        return
    fi
    grep -rq ptt "$HYPR_DIR" 2>/dev/null && return
    local p="${PTT_ROOT/#$HOME/\~}/ptt"
    cat <<EOF

No keybind found. Add to the Hyprland config:

  hl.bind("F12", hl.dsp.exec_cmd("$p begin"))
  hl.bind("F12", hl.dsp.exec_cmd("$p end"), { release = true })

Then: hyprctl reload
EOF
}

print_mode() {
    local group_added="${1:-0}"
    printf '\n'
    if ((group_added)); then
        log_warn "Log out and back in for the input group to apply."
        log_warn "Until then ptt runs in deferred mode."
    elif group_in_db && ! group_in_session; then
        log_warn "This session predates the input group membership."
        log_warn "Log out and back in for live text."
    fi
    log_info "Mode: $(mode_desc)"
    log_info "      $(mode_effect)."
}

first_run() {
    heading "ptt install"
    print_plan
    if ! confirm "Proceed?"; then
        log_info "Nothing done."
        return 0
    fi

    run_or_stop "install ${REPO_PKGS[*]} from pacman, types the text" \
        sudo pacman -S --needed "${REPO_PKGS[@]}"
    run_or_stop "build ${AUR_PKGS[*]} from the AUR, the speech engine" \
        yay -S --needed "${AUR_PKGS[@]}"

    choose_model
    install_model "$PICK"

    mkdir -p "$(dirname "$BIN_LINK")"
    run_or_stop "link ptt onto PATH for terminal use" \
        ln -sfn "$PTT_ROOT/ptt" "$BIN_LINK"
    link_completions

    local group_added=0
    if ! group_in_db; then
        if offer_group; then group_added=1; fi
    fi

    heading "Done"
    print_bind_help
    print_mode "$group_added"
}

action_change_model() {
    choose_model
    install_model "$PICK"
    print_mode 0
}

action_join_group() {
    local group_added=0
    if offer_group; then group_added=1; fi
    print_mode "$group_added"
}

menu_installed() {
    local dir ver idx
    dir="$(current_model_dir)" || dir='unknown'
    if idx="$(model_index_for_dir "$dir")"; then
        ver="${MODEL_VERS[idx]}"
    else
        ver='unknown'
    fi

    local -a labels=() actions=()
    labels+=("change model") actions+=(action_change_model)
    if ! group_in_db; then
        labels+=("join the input group for live text") actions+=(action_join_group)
    fi
    labels+=("quit") actions+=(:)

    heading "ptt is installed"
    printf '\n  current model: %s (%s)\n' "$dir" "$ver"
    printf '  mode:          %s\n\n' "$(mode_desc)"
    if group_in_db && ! group_in_session; then
        log_warn "Log out and back in for live text to take effect."
        printf '\n'
    fi
    local i
    for i in "${!labels[@]}"; do
        printf '  %d) %s\n' "$((i + 1))" "${labels[i]}"
    done
    printf '\n'
    prompt_index "${#labels[@]}" "Choice" "$((${#labels[@]} - 1))"
    "${actions[PICK]}"
}

installed_model_pkgs() {
    local pkg
    for pkg in "${MODEL_PKGS[@]}"; do
        if pkg_installed "$pkg"; then printf '%s\n' "$pkg"; fi
    done
}

cmd_install() {
    if is_installed; then
        offer_relink
        menu_installed
    else
        first_run
    fi
}

cmd_uninstall() {
    local -a rm_pkgs=()
    if pkg_installed nerd-dictation-git; then rm_pkgs+=(nerd-dictation-git); fi
    mapfile -t -O "${#rm_pkgs[@]}" rm_pkgs < <(installed_model_pkgs)

    # Only offer what is actually there.
    local do_cfg=0 do_link=0 do_group=0 do_zsh=0 do_bash=0 n=0
    if [[ -e $ND_CONFIG ]]; then do_cfg=1; fi
    if [[ -e $BIN_LINK || -L $BIN_LINK ]]; then do_link=1; fi
    if [[ -L $ZSH_COMP_LINK ]]; then do_zsh=1; fi
    if [[ -L $BASH_COMP_LINK ]]; then do_bash=1; fi
    if group_in_db; then do_group=1; fi

    heading "ptt uninstall"
    if ((${#rm_pkgs[@]} == 0 && !do_cfg && !do_link && !do_zsh && !do_bash && !do_group)); then
        log_info "Nothing to remove, ptt is not installed."
        return 0
    fi

    plan_title "ptt uninstall will:"
    if ((${#rm_pkgs[@]})); then
        plan_line "$((++n))" "remove $(arg "${rm_pkgs[*]}")"
    fi
    if ((do_cfg)); then
        plan_line "$((++n))" "remove $(arg "${ND_CONFIG/#$HOME/\~}")"
    fi
    if ((do_link)); then
        plan_line "$((++n))" "remove $(arg "${BIN_LINK/#$HOME/\~}")"
    fi
    if ((do_zsh)); then
        plan_line "$((++n))" "remove $(arg "$ZSH_COMP_LINK")"
    fi
    if ((do_bash)); then
        plan_line "$((++n))" "remove $(arg "$BASH_COMP_LINK")"
    fi
    if ((do_group)); then
        plan_line "$((++n))" "leave the $(arg input) group"
    fi
    printf '\n'
    plan_note "$(printf '%s is left in place.' "${PTT_ROOT/#$HOME/\~}")"
    plan_step_note
    if ! confirm "Proceed?"; then
        log_info "Nothing done."
        return 0
    fi

    if ((${#rm_pkgs[@]})); then
        run_cmd "remove the engine and models, with their orphaned deps" \
            yay -Rns "${rm_pkgs[@]}" || true
    fi
    if ((do_cfg)); then
        run_cmd "remove the model symlink" rm -rf "$ND_CONFIG" || true
    fi
    if ((do_link)); then
        run_cmd "unlink ptt from PATH" rm -f "$BIN_LINK" || true
    fi
    if ((do_zsh)); then
        run_cmd "unlink the zsh completion" sudo rm -f "$ZSH_COMP_LINK" || true
    fi
    if ((do_bash)); then
        run_cmd "unlink the bash completion" sudo rm -f "$BASH_COMP_LINK" || true
    fi
    if ((do_group)) && ask_cmd "leave the input group" \
        sudo gpasswd -d "$USER_NAME" input; then
        log_warn "The input group is dropped in the database."
        log_warn "Log out and back in to clear it from this session."
    fi
    log_info "Done."
}

main() {
    local a cmd=''
    for a in "$@"; do
        case "$a" in
            -h | --help)
                usage ptt-install
                return 0
                ;;
            -s | --step) PTT_STEP=1 ;;
            install | uninstall)
                if [[ -n $cmd ]]; then bad_arg ptt-install "$a"; fi
                cmd="$a"
                ;;
            *) bad_arg ptt-install "$a" ;;
        esac
    done

    case "${cmd:-install}" in
        install) cmd_install ;;
        uninstall) cmd_uninstall ;;
    esac
}

main "$@"
