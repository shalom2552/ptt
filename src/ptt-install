#!/usr/bin/env bash
# ptt-install - install or remove the ptt voice typing stack.
set -Eeuo pipefail

PTT_ROOT="$(dirname "$(dirname "$(readlink -f "$0")")")"
source "$PTT_ROOT/src/lib/log.sh"
source "$PTT_ROOT/src/lib/ui.sh"

# Swapping the speech engine should mean rewriting this block and nothing else.
ND_BIN=nerd-dictation
AUR_PKGS=(nerd-dictation-git)
ND_CONFIG="$HOME/.config/$ND_BIN"

BIN_LINK="$HOME/.local/bin/ptt"
MODEL_LINK="$ND_CONFIG/model"
MODEL_ROOT="/usr/share/vosk-models"
HYPR_DIR="$HOME/.config/hypr"

# A shell that is not installed has no link directory.
COMP_SHELLS=(zsh bash)
COMP_LINKS=(
    /usr/share/zsh/site-functions/_ptt
    /usr/share/bash-completion/completions/ptt
)
COMP_SRCS=(
    "$PTT_ROOT/share/completions/ptt.zsh"
    "$PTT_ROOT/share/completions/ptt.bash"
)

REPO_PKGS=(wtype)

# Model menu, smallest first.
MODEL_PKGS=(vosk-model-small-en-us vosk-model-en-us-lgraph vosk-model-en-us)
MODEL_DIRS=(small-en-us en-us-lgraph en-us)
MODEL_VERS=(0.15 0.22 0.22)
MODEL_SIZES=("~40 MB" "~128 MB" "~1.8 GB")
MODEL_LABELS=("fastest" "more accurate" "best, heavy")
DEFAULT_MODEL=0

trap 'log_error "failed on line $LINENO: $BASH_COMMAND"' ERR

pkg_installed() { pacman -Qq "$1" &>/dev/null; }

is_installed() {
    command -v "$ND_BIN" &>/dev/null && [[ -L $MODEL_LINK ]]
}

current_model_dir() {
    local target
    target="$(readlink "$MODEL_LINK" 2>/dev/null)" || return 1
    basename "$target"
}

model_index_for_dir() {
    local dir="$1" i
    for i in "${!MODEL_DIRS[@]}"; do
        if [[ ${MODEL_DIRS[i]} == "$dir" ]]; then
            printf '%s' "$i"
            return 0
        fi
    done
    return 1
}

installed_model_pkgs() {
    local pkg
    for pkg in "${MODEL_PKGS[@]}"; do
        if pkg_installed "$pkg"; then printf '%s\n' "$pkg"; fi
    done
}

link_current() {
    [[ -L $1 && "$(readlink -f "$1")" == "$(readlink -f "$2")" ]]
}

link_comp() {
    local i="$1"
    run_cmd "link the ${COMP_SHELLS[i]} completion" \
        sudo ln -sfn "${COMP_SRCS[i]}" "${COMP_LINKS[i]}"
}

link_completions() {
    local i linked=0
    for i in "${!COMP_SHELLS[@]}"; do
        [[ -d ${COMP_LINKS[i]%/*} ]] || continue
        link_comp "$i" && linked=1
    done
    if ((linked)); then
        log_info "Tab completion works in a new shell."
    fi
}

# Links this copy should own and does not, after a move or an older install.
LINK_TODO=()
links_todo() {
    local i
    LINK_TODO=()
    if [[ ! -e $BIN_LINK || -L $BIN_LINK ]] &&
        ! link_current "$BIN_LINK" "$PTT_ROOT/ptt"; then
        LINK_TODO+=(bin)
    fi
    for i in "${!COMP_SHELLS[@]}"; do
        [[ -d ${COMP_LINKS[i]%/*} ]] || continue
        link_current "${COMP_LINKS[i]}" "${COMP_SRCS[i]}" ||
            LINK_TODO+=("comp$i")
    done
}

link_target() {
    case "$1" in
        bin) printf '%s' "${BIN_LINK/#$HOME/\~}" ;;
        *) printf '%s' "${COMP_LINKS[${1#comp}]}" ;;
    esac
}

link_apply() {
    local item linked=0
    mkdir -p "${BIN_LINK%/*}"
    for item in "${LINK_TODO[@]}"; do
        if [[ $item == bin ]]; then
            run_cmd "point ptt on PATH at this copy" \
                ln -sfn "$PTT_ROOT/ptt" "$BIN_LINK" || true
        elif link_comp "${item#comp}"; then
            linked=1
        fi
    done
    if ((linked)); then
        log_info "Tab completion works in a new shell."
    fi
}

offer_links() {
    links_todo
    ((${#LINK_TODO[@]})) || return 0

    local item n=0
    heading "ptt links"
    plan_title "ptt install will:"
    for item in "${LINK_TODO[@]}"; do
        plan_line "$((++n))" \
            "point $(arg "$(link_target "$item")") at this copy"
    done
    printf '\n'
    plan_step_note
    if ! confirm "Proceed?"; then
        log_warn "The links are left as they are."
        return 0
    fi
    link_apply
}

choose_model() {
    local i label
    heading "Choose a model"
    printf '\n'
    for i in "${!MODEL_PKGS[@]}"; do
        label="$C_DIM${MODEL_LABELS[i]}"
        if ((i == DEFAULT_MODEL)); then
            label+=", $C_RESET${C_ARG}default"
        fi
        printf '  %d) %-24s %-5s %-8s %s%s\n' \
            "$((i + 1))" "${MODEL_PKGS[i]}" "${MODEL_VERS[i]}" \
            "${MODEL_SIZES[i]}" "$label" "$C_RESET"
        printf '     %s%s%s\n\n' \
            "$C_DIM" "$MODEL_ROOT/${MODEL_DIRS[i]}" "$C_RESET"
    done
    note "Sizes are downloads. Speed is CPU bound."
    note "The big model lags on modest hardware."
    printf '\n'
    prompt_index "${#MODEL_PKGS[@]}" "Model" "$DEFAULT_MODEL"
}

install_model() {
    local i="$1" link="${MODEL_LINK/#$HOME/\~}"
    run_or_stop \
        "install the ${MODEL_DIRS[i]} model, ${MODEL_SIZES[i]} download" \
        yay -S --needed --noconfirm "${MODEL_PKGS[i]}"
    mkdir -p "$ND_CONFIG"
    run_or_stop "point $ND_BIN at that model" \
        ln -sfn "$MODEL_ROOT/${MODEL_DIRS[i]}" "$MODEL_LINK"
    log_info "model: ${MODEL_DIRS[i]} (${MODEL_VERS[i]}) linked at $link"
}

print_plan() {
    local n=0 i dir
    plan_title "ptt install will:"
    plan_line "$((++n))" \
        "install $(arg "${REPO_PKGS[*]}") from the official repos"
    plan_line "$((++n))" "install $(arg "${AUR_PKGS[*]}") from the AUR"
    plan_line "$((++n))" "install a vosk model, picked from a menu"
    plan_line "$((++n))" "point $(arg "${MODEL_LINK/#$HOME/\~}") at that model"
    plan_line "$((++n))" "link ptt onto PATH at $(arg "${BIN_LINK/#$HOME/\~}")"
    for i in "${!COMP_SHELLS[@]}"; do
        dir="${COMP_LINKS[i]%/*}"
        [[ -d $dir ]] || continue
        plan_line "$((++n))" \
            "link the ${COMP_SHELLS[i]} completion into $(arg "$dir")"
    done
    printf '\n'
    plan_step_note
}

print_bind_help() {
    if [[ ! -d $HYPR_DIR ]]; then
        log_info "ptt is installed and runs from a terminal."
        log_info "Key binding is compositor specific."
        return
    fi
    grep -rq ptt "$HYPR_DIR" 2>/dev/null && return
    local p="${PTT_ROOT/#$HOME/\~}/ptt"
    log_info "No keybind found. Add to the Hyprland config:"
    printf '\n'
    note "hl.bind(\"Pause\", hl.dsp.exec_cmd(\"$p begin\"))"
    note "hl.bind(\"Pause\", hl.dsp.exec_cmd(\"$p end\"), { release = true })"
    printf '\n'
    log_info "Then run: hyprctl reload"
}

first_run() {
    if ! command -v yay &>/dev/null; then
        log_error "yay is not installed, the AUR packages need it"
        exit 1
    fi
    heading "ptt install"
    print_plan
    if ! confirm "Proceed?"; then
        log_info "Nothing done."
        return 0
    fi

    run_or_stop "install ${REPO_PKGS[*]} from pacman, types the text" \
        sudo pacman -S --needed --noconfirm "${REPO_PKGS[@]}"
    run_or_stop "build ${AUR_PKGS[*]} from the AUR, the speech engine" \
        yay -S --needed --noconfirm "${AUR_PKGS[@]}"

    choose_model
    local model_idx="$PICK"
    install_model "$model_idx"

    mkdir -p "${BIN_LINK%/*}"
    if [[ ! -e $BIN_LINK || -L $BIN_LINK ]]; then
        run_or_stop "link ptt onto PATH for terminal use" \
            ln -sfn "$PTT_ROOT/ptt" "$BIN_LINK"
    else
        log_warn "${BIN_LINK/#$HOME/\~} is a real file, left as it is"
    fi
    link_completions

    heading "ptt installed"
    printf '\n'
    field packages "${REPO_PKGS[*]} ${AUR_PKGS[*]}"
    field model "${MODEL_DIRS[model_idx]} (${MODEL_VERS[model_idx]})" \
        "${MODEL_LABELS[model_idx]}"
    field ptt "${BIN_LINK/#$HOME/\~}"
    printf '\n'
    print_bind_help
}

change_model() {
    choose_model
    local i="$PICK"
    install_model "$i"

    heading "ptt model set"
    printf '\n'
    field model "${MODEL_DIRS[i]} (${MODEL_VERS[i]})" "${MODEL_LABELS[i]}"
    field link "${MODEL_LINK/#$HOME/\~}"
}

menu_installed() {
    local dir ver idx label=''
    dir="$(current_model_dir)" || dir='unknown'
    if idx="$(model_index_for_dir "$dir")"; then
        ver="${MODEL_VERS[idx]}"
        label="${MODEL_LABELS[idx]}"
    else
        ver='unknown'
    fi

    local -a labels=() actions=()
    labels+=("change model") actions+=(change_model)
    labels+=("quit") actions+=(:)

    heading "ptt is installed"
    printf '\n'
    field model "$dir ($ver)" "$label"
    printf '\n'
    local i
    for i in "${!labels[@]}"; do
        printf '  %d) %s\n' "$((i + 1))" "${labels[i]}"
    done
    printf '\n'
    prompt_index "${#labels[@]}" "Choice" "$((${#labels[@]} - 1))"
    "${actions[PICK]}"
}

# What is actually there to remove. RM_PKGS is the package list for one line.
RM_TODO=()
RM_PKGS=()
uninstall_todo() {
    local pkg i
    RM_TODO=() RM_PKGS=()
    for pkg in "${AUR_PKGS[@]}"; do
        pkg_installed "$pkg" && RM_PKGS+=("$pkg")
    done
    mapfile -t -O "${#RM_PKGS[@]}" RM_PKGS < <(installed_model_pkgs)
    ((${#RM_PKGS[@]})) && RM_TODO+=(pkgs)
    [[ -e $MODEL_LINK || -L $MODEL_LINK ]] && RM_TODO+=(cfg)
    [[ -e $BIN_LINK || -L $BIN_LINK ]] && RM_TODO+=(link)
    for i in "${!COMP_SHELLS[@]}"; do
        [[ -L ${COMP_LINKS[i]} ]] && RM_TODO+=("comp$i")
    done
    : # a false last test must not return 1 into set -e
}

uninstall_plan() {
    local item n=0 i
    plan_title "ptt uninstall will:"
    for item in "${RM_TODO[@]}"; do
        case "$item" in
            pkgs) plan_line "$((++n))" "remove $(arg "${RM_PKGS[*]}")" ;;
            cfg)
                plan_line "$((++n))" "remove $(arg "${MODEL_LINK/#$HOME/\~}")"
                ;;
            link)
                plan_line "$((++n))" "remove $(arg "${BIN_LINK/#$HOME/\~}")"
                ;;
            comp*)
                i="${item#comp}"
                plan_line "$((++n))" "remove $(arg "${COMP_LINKS[i]}")"
                ;;
        esac
    done
    printf '\n'
    plan_note "$(printf '%s is left in place.' "${PTT_ROOT/#$HOME/\~}")"
    plan_step_note
}

uninstall_run() {
    local item i
    for item in "${RM_TODO[@]}"; do
        case "$item" in
            pkgs)
                run_cmd \
                    "remove the engine and models, with their orphaned deps" \
                    yay -Rns "${RM_PKGS[@]}" || true
                ;;
            cfg)
                run_cmd "remove the model symlink" rm -f "$MODEL_LINK" || true
                rmdir "$ND_CONFIG" 2>/dev/null || true
                ;;
            link)
                run_cmd "unlink ptt from PATH" rm -f "$BIN_LINK" || true
                ;;
            comp*)
                i="${item#comp}"
                run_cmd "unlink the ${COMP_SHELLS[i]} completion" \
                    sudo rm -f "${COMP_LINKS[i]}" || true
                ;;
        esac
    done
    log_info "Done."
}

# Every path out is a return, so an update never blocks an install.
offer_update() {
    git -C "$PTT_ROOT" rev-parse --git-dir &>/dev/null || return 0
    log_info "Checking for updates..."
    GIT_TERMINAL_PROMPT=0 git -C "$PTT_ROOT" fetch --quiet 2>/dev/null ||
        return 0
    local count
    count=$(git -C "$PTT_ROOT" rev-list --count HEAD..@{u} 2>/dev/null) ||
        return 0
    ((count)) || return 0

    heading "Update available"
    plan_title "New commits:"
    git -C "$PTT_ROOT" --no-pager log --oneline --no-merges -n 20 HEAD..@{u} ||
        return 0
    printf '\n'
    # Untracked files never block a rebase, tracked changes do.
    if [[ -n "$(git -C "$PTT_ROOT" status --porcelain -uno)" ]]; then
        log_warn "The clone has local changes. Update skipped."
        return 0
    fi
    confirm "Update ptt?" || return 0
    if ! git -C "$PTT_ROOT" pull --rebase; then
        log_warn "Update skipped, install carries on."
        return 0
    fi
    exec "$PTT_ROOT/src/ptt-install" install
}

cmd_install() {
    offer_update
    if is_installed; then
        offer_links
        menu_installed
    else
        first_run
    fi
}

# Picks a model and nothing else, so no stale link check.
cmd_model() {
    if ! is_installed; then
        log_error "ptt is not installed, run: ptt install"
        exit 1
    fi
    change_model
}

cmd_uninstall() {
    uninstall_todo
    heading "ptt uninstall"
    if ((${#RM_TODO[@]} == 0)); then
        log_info "Nothing to remove, ptt is not installed."
        return 0
    fi
    uninstall_plan
    if ! confirm "Proceed?"; then
        log_info "Nothing done."
        return 0
    fi
    uninstall_run
}

main() {
    local a cmd='' model=0 model_arg=''
    for a in "$@"; do
        case "$a" in
            -h | --help)
                usage ptt
                return 0
                ;;
            -s | --step) export PTT_STEP=1 ;;
            -m | --model)
                model=1
                model_arg="$a"
                ;;
            install | uninstall)
                if [[ -n $cmd ]]; then bad_arg ptt "$a"; fi
                cmd="$a"
                ;;
            *) bad_arg ptt "$a" ;;
        esac
    done

    case "${cmd:-install}" in
        install)
            if ((model)); then cmd_model; else cmd_install; fi
            ;;
        uninstall)
            if ((model)); then bad_arg ptt "$model_arg"; fi
            cmd_uninstall
            ;;
    esac
}

main "$@"
