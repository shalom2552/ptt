#!/usr/bin/env bash
# ptt-install - install, re-configure, or remove the ptt voice typing stack.
set -euo pipefail

PTT_DIR="$HOME/.local/share/ptt"
BIN_LINK="$HOME/.local/bin/ptt"
ND_CONFIG="$HOME/.config/nerd-dictation"
MODEL_LINK="$ND_CONFIG/model"
MODEL_ROOT="/usr/share/vosk-models"
HYPR_DIR="$HOME/.config/hypr"
USER_NAME="${USER:-$(id -un)}"

REPO_PKGS=(wtype)
AUR_PKGS=(nerd-dictation-git)

# Model menu, smallest first. DEFAULT_MODEL is the index preselected on enter.
MODEL_PKGS=(vosk-model-small-en-us vosk-model-en-us-lgraph vosk-model-en-us)
MODEL_DIRS=(small-en-us en-us-lgraph en-us)
MODEL_VERS=(0.15 0.22 0.22)
MODEL_SIZES=("~40 MB" "~128 MB" "~1.8 GB")
DEFAULT_MODEL=0

if [[ -t 1 ]]; then
    C_RESET=$'\e[0m'
    C_BOLD=$'\e[1m'
    C_DIM=$'\e[2m'
    C_PTT=$'\e[1;36m'
    C_WARN=$'\e[1;33m'
    C_ERROR=$'\e[1;31m'
else
    C_RESET='' C_BOLD='' C_DIM='' C_PTT='' C_WARN='' C_ERROR=''
fi

# Prefixed with [ptt] so our output never reads as pacman's.
log_info() { printf '%s[ptt] ==>%s %s\n' "$C_PTT" "$C_RESET" "$*"; }
log_warn() { printf '%s[ptt] ==>%s %s\n' "$C_WARN" "$C_RESET" "$*" >&2; }
log_error() { printf '%s[ptt] ==>%s %s\n' "$C_ERROR" "$C_RESET" "$*" >&2; }

rule() { printf '%s%s%s\n' "$C_DIM" "────────────────────────────────────────────────────────" "$C_RESET"; }

heading() {
    printf '\n'
    rule
    printf '%s[ptt] ==>%s %s%s%s\n' "$C_PTT" "$C_RESET" "$C_BOLD" "$1" "$C_RESET"
    rule
}

# Every confirm shows the exact commands it is about to run.
confirm_commands() {
    local prompt="$1" reply line
    shift
    printf '\n%s[ptt] ==>%s these commands will run:\n\n' "$C_PTT" "$C_RESET"
    while IFS= read -r line; do
        [[ -n $line ]] && printf '    %s$%s %s%s%s\n' "$C_DIM" "$C_RESET" "$C_BOLD" "$line" "$C_RESET"
    done <<<"$*"
    printf '\n'
    read -rp "$prompt [n/Y] " reply || return 1
    case "${reply,,}" in
        n | no) return 1 ;;
        *) return 0 ;;
    esac
}

# Menu picker. Writes the prompt to stderr, sets PICK to a 0-based index.
PICK=0
prompt_index() {
    local count="$1" label="$2" default="${3:-}" reply hint
    hint="1-$count"
    [[ -n $default ]] && hint="$hint, default $((default + 1))"
    while true; do
        read -rp "$label [$hint]: " reply || reply=''
        [[ -z $reply && -n $default ]] && reply=$((default + 1))
        if [[ $reply =~ ^[0-9]+$ ]] && ((reply >= 1 && reply <= count)); then
            PICK=$((reply - 1))
            return 0
        fi
        log_error "pick a number between 1 and $count"
    done
}

pkg_installed() { pacman -Qq "$1" &>/dev/null; }

# The group database, not this session's credentials.
group_in_db() {
    getent group input 2>/dev/null | cut -d: -f4 | tr ',' '\n' | grep -qx "$USER_NAME"
}

# What this session actually has. Only set at login, so it can lag the database.
group_in_session() { id -nG | tr ' ' '\n' | grep -qx input; }

mode_desc() {
    if group_in_session; then
        echo "live (in input group)"
    elif group_in_db; then
        echo "deferred until logout (in input group, session predates it)"
    else
        echo "deferred (not in input group)"
    fi
}

mode_effect() {
    if group_in_session; then
        echo "text appears as you speak"
    else
        echo "the whole utterance appears when you release the key"
    fi
}

is_installed() {
    command -v nerd-dictation &>/dev/null && [[ -L $MODEL_LINK ]]
}

model_index_for_dir() {
    local dir="$1" i
    for i in "${!MODEL_DIRS[@]}"; do
        if [[ ${MODEL_DIRS[i]} == "$dir" ]]; then
            printf '%s' "$i"
            return 0
        fi
    done
    return 1
}

current_model_dir() {
    local target
    target="$(readlink "$MODEL_LINK" 2>/dev/null)" || return 1
    basename "$target"
}

plan_commands() {
    printf 'sudo pacman -S --needed %s\n' "${REPO_PKGS[*]}"
    printf 'yay -S --needed %s\n' "${AUR_PKGS[*]}"
    printf 'yay -S --needed <the model you pick next>\n'
    printf 'ln -sfn %s/<model> %s\n' "$MODEL_ROOT" "${MODEL_LINK/#$HOME/\~}"
    printf 'ln -sfn %s/ptt %s\n' "${PTT_DIR/#$HOME/\~}" "${BIN_LINK/#$HOME/\~}"
    if ! group_in_db; then
        printf 'sudo gpasswd -a %s input   (offered separately)\n' "$USER_NAME"
    fi
}

choose_model() {
    local i
    heading "Choose a model" >&2
    printf '\n' >&2
    for i in "${!MODEL_PKGS[@]}"; do
        printf '  %d) %-24s %-5s %-9s %-34s%s\n' \
            "$((i + 1))" "${MODEL_PKGS[i]}" "${MODEL_VERS[i]}" "${MODEL_SIZES[i]}" \
            "$MODEL_ROOT/${MODEL_DIRS[i]}" \
            "$([[ $i -eq $DEFAULT_MODEL ]] && echo ' (default)')" >&2
    done
    printf '\n' >&2
    prompt_index "${#MODEL_PKGS[@]}" "Model" "$DEFAULT_MODEL" >&2
}

install_model() {
    local i="$1"
    log_info "running: yay -S --needed ${MODEL_PKGS[i]}"
    yay -S --needed "${MODEL_PKGS[i]}"
    mkdir -p "$ND_CONFIG"
    ln -sfn "$MODEL_ROOT/${MODEL_DIRS[i]}" "$MODEL_LINK"
    log_info "model: ${MODEL_DIRS[i]} (${MODEL_VERS[i]}) linked at ${MODEL_LINK/#$HOME/\~}"
}

offer_group() {
    heading "Live text needs the input group"
    printf '\nJoin the input group for live text as you speak, or decline and get deferred mode, where the whole utterance appears on key release.\n'
    confirm_commands "Join the input group?" "sudo gpasswd -a $USER_NAME input" || return 1
    sudo gpasswd -a "$USER_NAME" input
    return 0
}

print_bind_help() {
    if [[ ! -d $HYPR_DIR ]]; then
        log_info "ptt is installed and works from a terminal. Binding it to a key is up to the compositor you use."
        return
    fi
    grep -rq ptt "$HYPR_DIR" 2>/dev/null && return
    cat <<'EOF'

No keybind found. Add to ~/.config/hypr/modules/machine.lua:

  hl.bind("F12", hl.dsp.exec_cmd("~/.local/share/ptt/ptt begin"))
  hl.bind("F12", hl.dsp.exec_cmd("~/.local/share/ptt/ptt end"), { release = true })

Then: hyprctl reload
EOF
}

print_mode() {
    local group_added="${1:-0}"
    if ((group_added)); then
        log_warn "Log out and back in fully for the input group to apply. Until then ptt runs in deferred mode."
    elif group_in_db && ! group_in_session; then
        log_warn "You are already in the input group but this session predates it. Log out and back in for live text."
    fi
    log_info "Mode: $(mode_desc), $(mode_effect)."
}

first_run() {
    heading "ptt install"
    if ! confirm_commands "Proceed?" "$(plan_commands)"; then
        log_info "Nothing done."
        return 0
    fi

    log_info "running: sudo pacman -S --needed ${REPO_PKGS[*]}"
    sudo pacman -S --needed "${REPO_PKGS[@]}"
    log_info "running: yay -S --needed ${AUR_PKGS[*]}"
    yay -S --needed "${AUR_PKGS[@]}"

    choose_model
    install_model "$PICK"

    mkdir -p "$(dirname "$BIN_LINK")"
    ln -sfn "$PTT_DIR/ptt" "$BIN_LINK"
    log_info "linked ${BIN_LINK/#$HOME/\~} -> ${PTT_DIR/#$HOME/\~}/ptt"

    local group_added=0
    if ! group_in_db; then
        if offer_group; then group_added=1; fi
    fi

    heading "Done"
    print_bind_help
    print_mode "$group_added"
}

action_change_model() {
    choose_model
    install_model "$PICK"
    print_mode 0
}

action_join_group() {
    local group_added=0
    if offer_group; then group_added=1; fi
    print_mode "$group_added"
}

menu_installed() {
    local dir ver idx
    dir="$(current_model_dir)" || dir='unknown'
    if idx="$(model_index_for_dir "$dir")"; then
        ver="${MODEL_VERS[idx]}"
    else
        ver='unknown'
    fi

    local -a labels=() actions=()
    labels+=("change model") actions+=(action_change_model)
    if ! group_in_db; then
        labels+=("join the input group for live text") actions+=(action_join_group)
    fi
    labels+=("quit") actions+=(:)

    heading "ptt is installed"
    printf '\n  current model: %s (%s)\n' "$dir" "$ver"
    printf '  mode:          %s\n\n' "$(mode_desc)"
    if group_in_db && ! group_in_session; then
        log_warn "Log out and back in for live text to take effect."
        printf '\n'
    fi
    local i
    for i in "${!labels[@]}"; do
        printf '  %d) %s\n' "$((i + 1))" "${labels[i]}"
    done
    printf '\n'
    prompt_index "${#labels[@]}" "Choice"
    "${actions[PICK]}"
}

installed_model_pkgs() {
    local pkg
    for pkg in "${MODEL_PKGS[@]}"; do
        if pkg_installed "$pkg"; then printf '%s\n' "$pkg"; fi
    done
}

cmd_install() {
    if is_installed; then
        menu_installed
    else
        first_run
    fi
}

cmd_uninstall() {
    local -a rm_pkgs=()
    if pkg_installed nerd-dictation-git; then rm_pkgs+=(nerd-dictation-git); fi
    mapfile -t -O "${#rm_pkgs[@]}" rm_pkgs < <(installed_model_pkgs)

    local cmds=''
    if ((${#rm_pkgs[@]})); then
        cmds+="yay -Rns ${rm_pkgs[*]}"$'\n'
    fi
    cmds+="rm -rf ${ND_CONFIG/#$HOME/\~}"$'\n'
    cmds+="rm -f ${BIN_LINK/#$HOME/\~}"$'\n'
    if group_in_db; then
        cmds+="sudo gpasswd -d $USER_NAME input"$'\n'
    fi

    heading "ptt uninstall"
    printf '\n%s is left in place.\n' "${PTT_DIR/#$HOME/\~}"
    if ! confirm_commands "Proceed?" "$cmds"; then
        log_info "Nothing done."
        return 0
    fi

    if ((${#rm_pkgs[@]})); then
        yay -Rns "${rm_pkgs[@]}"
    fi
    rm -rf "$ND_CONFIG"
    rm -f "$BIN_LINK"
    if group_in_db; then
        sudo gpasswd -d "$USER_NAME" input
        log_warn "Log out and back in fully before the input group is actually gone for this session."
    fi
    log_info "Done."
}

main() {
    case "${1:-install}" in
        install) cmd_install ;;
        uninstall) cmd_uninstall ;;
        *)
            log_error "unknown command: $1"
            printf 'usage: ptt-install [install|uninstall]\n' >&2
            exit 1
            ;;
    esac
}

main "$@"
