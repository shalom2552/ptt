#!/usr/bin/env bash
# ptt - push to talk voice typing. begin and end run off a key press,
# install and uninstall hand off to ptt-install.
set -Eeuo pipefail

# Resolved through the symlink, so ~/.local/bin/ptt finds ptt-install.
DIR="$(dirname "$(readlink -f "$0")")"

# Swapping the speech engine should mean rewriting this block and nothing else.
BIN=nerd-dictation
ARGS=(
    --simulate-input-tool=WTYPE
    # Nothing is typed during the hold. Without it wtype types into the
    # compositor, Hyprland loses the key release, and dictation never stops.
    --defer-output
    --idle-time=0.2
    --punctuate-from-previous-timeout=2
    --full-sentence
    # Hang backstop: the engine exits on its own after 30s with no speech
    # processed, so a session that loses its release dies by itself.
    --timeout 30
)
PKGS=(wtype nerd-dictation-git)
# Must match the Hyprland bind in ~/.config/hypr/modules/machine.lua.
KEY=F12
KEYCODE=88

# The packaged binary is a python script run through /usr/bin/env, so a live
# session shows as "python3 /usr/bin/nerd-dictation begin ...". Ending shows as
# "... end", which this must not match.
PATTERN="$BIN begin"

# -E propagates this into functions. Off a key press there is no terminal to
# print to, so failures go to the screen.
trap 'notify-send -u critical -t 10000 "ptt failed" "line $LINENO: $BASH_COMMAND"' ERR

# A missing engine off a key press is otherwise invisible.
require_engine() {
    if ! command -v "$BIN" &>/dev/null; then
        notify-send -t 10000 "Voice typing not installed" \
            "Run: ~/.local/share/ptt/ptt install"
        exit 0
    fi
}

cmd_begin() {
    require_engine
    # A second press while a session runs would fight the first for the mic.
    pgrep -f "$PATTERN" &>/dev/null && exit 0
    exec "$BIN" begin "${ARGS[@]}"
}

cmd_end() {
    require_engine
    # Without this, a release with nothing running throws a Python traceback
    # off a stale cookie.
    pgrep -f "$PATTERN" &>/dev/null || exit 0
    exec "$BIN" end
}

case "${1:-}" in
    begin) cmd_begin ;;
    end) cmd_end ;;
    install) exec "$DIR/ptt-install" install ;;
    uninstall) exec "$DIR/ptt-install" uninstall ;;
    *)
        printf 'usage: ptt [begin|end|install|uninstall]\n' >&2
        exit 1
        ;;
esac
