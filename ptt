#!/usr/bin/env bash
# ptt - push to talk voice typing. begin and end run off a key press,
# install and uninstall hand off to ptt-install.
set -Eeuo pipefail

DIR="$(dirname "$(readlink -f "$0")")"

# Swapping the speech engine should mean rewriting this block and nothing else.
BIN=nerd-dictation
ARGS=(
    --simulate-input-tool=WTYPE
    # Without this wtype types during the hold, Hyprland loses the key
    # release, and dictation never stops.
    --defer-output
    --idle-time=0.2
    --punctuate-from-previous-timeout=2
    --full-sentence
    # Hang backstop: exits on its own after 30s with no speech processed.
    --timeout 30
)
PKGS=(wtype nerd-dictation-git)
# Must match the Hyprland bind in ~/.config/hypr/modules/machine.lua.
KEY=F12
KEYCODE=88

# A live session shows as "python3 /usr/bin/nerd-dictation begin ...".
# Ending shows as "... end", which this must not match.
PATTERN="$BIN begin"

if [[ -t 1 ]]; then
    C_RESET=$'\e[0m'
    C_PTT=$'\e[1;36m'
    C_WARN=$'\e[1;33m'
    C_ERROR=$'\e[1;31m'
else
    C_RESET='' C_PTT='' C_WARN='' C_ERROR=''
fi

log_info() { printf '%s[ptt] INFO ==>%s %s\n' "$C_PTT" "$C_RESET" "$*"; }
log_warn() { printf '%s[ptt] WARN ==>%s %s\n' "$C_WARN" "$C_RESET" "$*" >&2; }
log_error() { printf '%s[ptt] ERR  ==>%s %s\n' "$C_ERROR" "$C_RESET" "$*" >&2; }

# Off a key press there is no terminal, so failures also go to the screen.
trap 'log_error "failed on line $LINENO: $BASH_COMMAND"
      notify-send -u critical -t 10000 "ptt failed" "line $LINENO: $BASH_COMMAND"' ERR

require_engine() {
    if ! command -v "$BIN" &>/dev/null; then
        notify-send -t 10000 "Voice typing not installed" \
            "Run: ${DIR/#$HOME/\~}/ptt install"
        exit 0
    fi
}

cmd_begin() {
    require_engine
    pgrep -f "$PATTERN" &>/dev/null && exit 0
    "$BIN" begin "${ARGS[@]}"
}

cmd_end() {
    require_engine
    # Without this guard a release with nothing running throws a Python
    # traceback off a stale cookie.
    pgrep -f "$PATTERN" &>/dev/null || exit 0
    "$BIN" end
}

case "${1:-}" in
    begin) cmd_begin ;;
    end) cmd_end ;;
    install) exec "$DIR/ptt-install" install ;;
    uninstall) exec "$DIR/ptt-install" uninstall ;;
    *)
        log_error "unknown command: ${1:-}"
        printf 'usage: ptt [begin|end|install|uninstall]\n' >&2
        exit 1
        ;;
esac
