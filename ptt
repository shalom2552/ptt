#!/usr/bin/env bash
# ptt - push to talk voice typing. begin and end run off a key press,
# install and uninstall hand off to ptt-install.
set -Eeuo pipefail

DIR="$(dirname "$(readlink -f "$0")")"

# Swapping the speech engine should mean rewriting this block and nothing else.
BIN=nerd-dictation
ARGS=(
    --simulate-input-tool=WTYPE
    --idle-time=0.2
    --punctuate-from-previous-timeout=2
    --full-sentence
    # Hang backstop: exits on its own after 30s with no speech processed.
    --timeout 30
)
# Deferred mode only. Without it wtype types during the hold, Hyprland loses
# the key release, and dictation never stops. Live mode reads the release off
# the device instead, so it does not care what wtype does.
DEFER_ARGS=(--defer-output)
PKGS=(wtype nerd-dictation-git)
# Must match the Hyprland bind.
KEY=F12
KEYCODE=88

# A live session shows as "python3 /usr/bin/nerd-dictation begin ...".
# Ending shows as "... end", which this must not match.
PATTERN="$BIN begin"

if [[ -t 1 ]]; then
    C_RESET=$'\e[0m'
    C_PTT=$'\e[1;36m'
    C_WARN=$'\e[1;33m'
    C_ERROR=$'\e[1;31m'
else
    C_RESET='' C_PTT='' C_WARN='' C_ERROR=''
fi

log_info() { printf '%s[ptt] INFO ==>%s %s\n' "$C_PTT" "$C_RESET" "$*"; }
log_warn() { printf '%s[ptt] WARN ==>%s %s\n' "$C_WARN" "$C_RESET" "$*" >&2; }
log_error() { printf '%s[ptt] ERR  ==>%s %s\n' "$C_ERROR" "$C_RESET" "$*" >&2; }

# Off a key press there is no terminal, so failures also go to the screen.
trap 'log_error "failed on line $LINENO: $BASH_COMMAND"
      notify-send -u critical -t 10000 "ptt failed" "line $LINENO: $BASH_COMMAND"' ERR

require_engine() {
    if ! command -v "$BIN" &>/dev/null; then
        notify-send -t 10000 "Voice typing not installed" \
            "Run: ${DIR/#$HOME/\~}/ptt install"
        exit 0
    fi
}

# Readability, not group membership. The group database says input the moment
# gpasswd runs, but the running session lacks it until a full logout, which
# would pick live mode and then hang with nothing to read.
can_watch() {
    local dev
    for dev in /dev/input/event*; do
        [[ -r $dev ]] && return 0
    done
    return 1
}

cmd_begin() {
    require_engine
    pgrep -f "$PATTERN" &>/dev/null && exit 0
    local -a args=("${ARGS[@]}")
    if can_watch; then
        "$DIR/ptt-keywatch" "$KEYCODE" && "$DIR/ptt" end &
    else
        args+=("${DEFER_ARGS[@]}")
    fi
    "$BIN" begin "${args[@]}"
}

cmd_end() {
    require_engine
    # The watcher is backgrounded before begin spawns the engine, so a quick
    # tap can land here first. Wait for the engine rather than dropping the
    # release on the floor.
    local deadline=$((SECONDS + 2))
    while ((SECONDS < deadline)); do
        pgrep -f "$PATTERN" &>/dev/null && break
        sleep 0.1
    done
    # Without this guard a release with nothing running throws a Python
    # traceback off a stale cookie.
    pgrep -f "$PATTERN" &>/dev/null || exit 0
    "$BIN" end
}

case "${1:-}" in
    begin) cmd_begin ;;
    end) cmd_end ;;
    install) exec "$DIR/ptt-install" install ;;
    uninstall) exec "$DIR/ptt-install" uninstall ;;
    *)
        log_error "unknown command: ${1:-}"
        printf 'usage: ptt [begin|end|install|uninstall]\n' >&2
        exit 1
        ;;
esac
